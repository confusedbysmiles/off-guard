{
  "name": "off-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Pathfinder 2e table application: GM dashboard, player character sheets, shared initiative screen.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backup": "node tools/backup.js",
    "build:data": "node tools/build-data/build.js",
    "build:data:fetch": "node tools/build-data/upstream.js",
    "build:fonts": "node tools/build-fonts/build.js",
    "build:reference": "node tools/build-reference/build.js",
    "build:tables": "node tools/build-tables/build.js",
    "check:contrast": "node tools/check-contrast.js",
    "mint-gm": "node tools/mint-gm-token.js",
    "start": "node src/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1"
  }
}
