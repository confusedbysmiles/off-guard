# Off-Guard configuration. Every value here has a working default; this file
# documents them rather than being required.

# Bind address. Keep this on loopback and put nginx in front -- the access model
# assumes TLS terminates somewhere, and a token in a URL over plain HTTP is a
# token written on a postcard.
OFF_GUARD_HOST=127.0.0.1
OFF_GUARD_PORT=8787

# Where the application lives on the host. Empty serves from the root;
# `/off-guard` serves from a subdirectory of a site that has other things on it.
# Nothing in the browser needs a matching setting -- the pages work their own
# mount point out from their address -- but nginx has to forward the same prefix
# without stripping it. See deploy/nginx.conf.
OFF_GUARD_BASE_PATH=

# The SQLite file. Anything with write access to its directory can read every
# campaign, every sheet and every token, so put it somewhere only this service
# can reach.
OFF_GUARD_DB=/var/lib/off-guard/off-guard.sqlite

# fatal | error | warn | info | debug | trace
# Request paths are never logged: the token is in the path.
OFF_GUARD_LOG_LEVEL=info

# The application's only outbound network call: fetching a Pathbuilder build by
# id when a player asks for one. Set to `off` to remove it entirely; the JSON
# export upload keeps working either way, and is the path that actually works,
# since pathbuilder2e.com answers servers with a Cloudflare bot check.
OFF_GUARD_PATHBUILDER_FETCH=on
