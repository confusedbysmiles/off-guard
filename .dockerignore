# The build context is sent to the daemon in full, so what is excluded here is
# the difference between a two-second build and shipping 67 MB of creature data
# and a compiled node_modules that would be thrown away anyway.

node_modules
.git
.cache
test-results
playwright-report

# Built catalogue: 67 MB, mounted at runtime rather than baked in.
# `data/reference.json` and `data/licenses/` are checked in and *are* copied,
# so they are excluded from this exclusion.
data/creatures
data/hazards
data/index.json
data/traits.json
data/glossary.json
data/build-report.json

*.sqlite
*.sqlite-wal
*.sqlite-shm
.env

e2e
tests
docs
